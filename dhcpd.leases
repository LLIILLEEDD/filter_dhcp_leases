  ends 4 2023/04/27 07:50:00;
  tstp 4 2023/04/27 07:50:00;
  cltt 4 2023/04/27 07:48:00;
  binding state free;
  hardware ethernet 34:97:f6:28:85:33;
  client-hostname "manager560-1";
  on expiry {
    set ClientIP = 
       binary-to-ascii (10, 8, ".", leased-address) ;
    log (debug, 
        concat ("Expired: IP: ", ClientIP));
    execute ("/home/dhcpd/bin/ddns/dhcp-dyndns-bg.sh", "del", ClientIP, "");
  }
  on release {
    set ClientIP = 
       binary-to-ascii (10, 8, ".", leased-address) ;
    log (debug, 
        concat ("Release: IP: ", ClientIP));
    execute ("/home/dhcpd/bin/ddns/dhcp-dyndns-bg.sh", "del", ClientIP, "");
  }
}
