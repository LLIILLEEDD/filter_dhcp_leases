  on release {
    set ClientIP = 
       binary-to-ascii (10, 8, ".", leased-address) ;
    log (debug, 
        concat ("Release: IP: ", ClientIP));
    execute ("/home/dhcpd/bin/ddns/dhcp-dyndns-bg.sh", "del", ClientIP, "");
  }
}
