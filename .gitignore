# Локальные снимки: содержат базы лиз, копии и прежние материалы.
/archive/pre_production_*/

# Кэш и результаты запусков.
__pycache__/
*.py[cod]
*.log
*.leases
*.bak
*.tmp
.*.dhcp-filter.lock

# Синтетический пример необходим для тестов.
!/archive/tests/fixtures/demo.leases
# Практическая DHCP-лаборатория: только локальные результаты и зависимости.
/tests/results/
/tests/.tools/
/tests/.lab-state.json
/tests/.lab.lock
/tests/.lab-state-*.tmp
!/tests/fixtures/*.leases
